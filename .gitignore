# macOS
.DS_Store

# Xcode project is generated by xcodegen from project.yml — never commit it
*.xcodeproj
xcuserdata/
DerivedData/
build/

# JS (no dependencies expected, but keep it safe)
webext/node_modules/

# Signing material
*.mobileprovision
*.p12

# Local signing settings (copy Config/Local.xcconfig.example)
Config/Local.xcconfig

# Local coding-agent state (history, cache)
.swival/

# CodeGraph index (local SQLite database and daemon files)
.codegraph/

# Python bytecode (scripts/)
__pycache__/

# App Store screenshots: large binaries, regenerated by scripts/store_screenshots.sh
docs/app-store/screenshots/
